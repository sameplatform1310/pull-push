rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No login: the log is open to anyone with the app.
    // Only month docs ("2026-10") holding an entries map are accepted.
    match /months/{month} {
      allow read: if true;
      allow create, update: if month.matches("[0-9]{4}-[0-9]{2}")
        && request.resource.data.keys().hasOnly(["entries"]);
    }
  }
}
